# ==============================================================================
# СИСТЕМНЫЙ МОДУЛЬ: modules/system/bluetooth.nix
# ==============================================================================
# Описание:
#   Активация и настройка беспроводного интерфейса Bluetooth:
#   - Демон BlueZ (bluetooth.service)
#   - Автоматическое включение контроллера при старте системы (powerOnBoot)
#   - Графический интерфейс Blueman (blueman-manager, blueman-applet в трее)
#   - Поддержка профилей A2DP / HSP / HFP для Bluetooth-наушников через PipeWire
#   - Отображение уровня заряда батареи подключенных устройств (Experimental = true)
#
# Полезные команды для терминала:
#   bluetoothctl power on              # Принудительно включить адаптер
#   bluetoothctl scan on               # Запустить поиск устройств
#   bluetoothctl devices               # Показать найденные устройства
#   bluetoothctl pair <MAC>            # Сопряжение с устройством
#   bluetoothctl connect <MAC>         # Подключение к устройству
#   rfkill list bluetooth              # Проверить аппаратную/программную блокировку
#   rfkill unblock bluetooth           # Разблокировать Bluetooth
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # ----------------------------------------------------------------------------
  # 1. АППАРАТНАЯ СЛУЖБА BLUETOOTH (BlueZ)
  # ----------------------------------------------------------------------------
  hardware.bluetooth = {
    enable = true;

    # Автоматически подавать питание на адаптер при загрузке системы,
    # чтобы не приходилось вручную вызывать `bluetoothctl power on`
    powerOnBoot = true;

    settings = {
      General = {
        # Включаем экспериментальные возможности BlueZ:
        # - Отображение уровня заряда батареи (Battery Provider) для наушников и мышек
        Experimental = true;
        # Ускоренный отклик для уже спаренных устройств
        FastConnectable = true;
      };
      Policy = {
        # Автоматическое включение контроллера при обнаружении
        AutoEnable = true;
      };
    };
  };

  # ----------------------------------------------------------------------------
  # 2. СЛУЖБА И УТИЛИТЫ BLUEMAN
  # ----------------------------------------------------------------------------
  # Предоставляет:
  # - blueman-applet (значок в трее Noctalia)
  # - blueman-manager (удобное окно поиска и подключения устройств)
  # - Polkit-правила для управления Bluetooth без постоянного ввода пароля sudo
  services.blueman.enable = true;

  # Дополнительные консольные утилиты для диагностики
  environment.systemPackages = with pkgs; [
    bluez       # Содержит bluetoothctl
    bluez-tools # bt-device, bt-adapter и другие скрипты
  ];
}
