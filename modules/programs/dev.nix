# ==============================================================================
# МОДУЛЬ РАЗРАБОТКИ: modules/programs/dev.nix
# ==============================================================================
# Описание:
#   Среды выполнения, компиляторы, утилиты и IDE для разработки:
#   - JavaScript / TypeScript: Node.js 26, Bun
#   - Rust: компилятор rustc и пакетный менеджер cargo
#   - Zig: компилятор zig и языковой сервер zls
#   - Python: Python 3.14 с поддержкой pip и virtualenv
#   - Go: компилятор go и специализированная IDE GoLand
#   - SQL: клиенты SQLite, PostgreSQL (psql) и графический DBeaver
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  home.packages = with pkgs; [
    # --------------------------------------------------------------------------
    # 1. JAVASCRIPT & TYPESCRIPT
    # --------------------------------------------------------------------------
    nodejs_26             # Свежая версия Node.js 26 (включает npm и npx)
    bun                   # Сверхбыстрый альтернативный рантайм Bun

    # --------------------------------------------------------------------------
    # 2. RUST & СИСТЕМНАЯ РАЗРАБОТКА
    # --------------------------------------------------------------------------
    rustc                 # Компилятор языка Rust
    cargo                 # Пакетный менеджер и сборщик проектов Cargo
    jetbrains.rust-rover

    # --------------------------------------------------------------------------
    # 3. ZIG
    # --------------------------------------------------------------------------
    zig                   # Компилятор языка Zig
    zls                   # Языковой сервер (LSP) для автодополнения кода на Zig

    # --------------------------------------------------------------------------
    # 4. PYTHON 3.14
    # --------------------------------------------------------------------------
    (python314.withPackages (ps: with ps; [
      pip                 # Установщик пакетов Python
      virtualenv          # Создание изолированных виртуальных окружений
    ]))
    jetbrains.pycharm

    # --------------------------------------------------------------------------
    # 5. GO & JETBRAINS GOLAND
    # --------------------------------------------------------------------------
    go                    # Компилятор и инструментарий языка Go
    jetbrains.goland      # Профессиональная IDE для Go от JetBrains

    # --------------------------------------------------------------------------
    # 6. SQL & РАБОТА С БАЗАМИ ДАННЫХ
    # --------------------------------------------------------------------------
    sqlite                # Консольная утилита для работы с базами SQLite
    postgresql            # Клиентские утилиты PostgreSQL (psql, pg_dump и др.)
    dbeaver-bin           # Универсальный графический менеджер баз данных SQL
  ];
}
