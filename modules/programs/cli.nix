# ==============================================================================
# МОДУЛЬ ПРОГРАММ: modules/programs/cli.nix
# ==============================================================================
# Описание:
#   Набор необходимых CLI-утилит для повседневной работы разработчика
#   и системного администрирования: Git, мониторинг ресурсов (htop, btop),
#   поиск (ripgrep, fd), современные просмотрщики (bat, eza) и диагностика.
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # ----------------------------------------------------------------------------
  # 1. СИСТЕМА КОНТРОЛЯ ВЕРСИЙ GIT
  # ----------------------------------------------------------------------------
  programs.git = {
    enable = true;

    settings = {
      user = {
        name = "jalioba";
        email = "jalioba@users.noreply.github.com"; # Замените на вашу актуальную почту
      };
      init.defaultBranch = "main";
      pull.rebase = true;
      push.autoSetupRemote = true;
      core.editor = "nvim";
    };
  };

  # ----------------------------------------------------------------------------
  # 2. МОНИТОРИНГ РЕСУРСОВ СИСТЕМЫ (HTOP & BTOP)
  # ----------------------------------------------------------------------------
  programs.htop = {
    enable = true;
    settings = {
      show_cpu_frequency = true;
      show_cpu_temperature = true;
      show_program_path = false;
      tree_view = true;
    };
  };

  programs.btop = {
    enable = true;
    settings = {
      color_theme = "catppuccin_mocha";
      theme_background = false; # Прозрачный фон под цвет терминала
      update_ms = 1000;
    };
  };

  # ----------------------------------------------------------------------------
  # 3. СОВРЕМЕННЫЙ ПРОСМОТР ТЕКСТА И ФАЙЛОВ (BAT & EZA)
  # ----------------------------------------------------------------------------
  programs.bat = {
    enable = true;
    config = {
      theme = "Catppuccin Mocha";
    };
  };

  programs.eza = {
    enable = true;
    icons = "auto";
    git = true;
  };

  # ----------------------------------------------------------------------------
  # 4. СПИСОК ДОПОЛНИТЕЛЬНЫХ УТИЛИТ
  # ----------------------------------------------------------------------------
  home.packages = with pkgs; [
    # Поиск
    ripgrep     # Сверхбыстрый grep (rg)
    fd          # Удобная и быстрая замена find

    # JSON и архивы
    jq          # Обработчик JSON в терминале
    unzip       # Распаковка zip-архивов
    zip         # Создание zip-архивов

    # Информация о системе и оборудовании
    fastfetch   # Красивая сводка о системе и логотип
    pciutils    # lspci (просмотр устройств PCI)
    usbutils    # lsusb (просмотр подключенных USB)

    # Прочее
    tree        # Дерево каталогов
    which       # Поиск пути к исполняемому файлу
  ];
}
