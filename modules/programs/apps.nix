# ==============================================================================
# МОДУЛЬ ПРИЛОЖЕНИЙ: modules/programs/apps.nix
# ==============================================================================
# Описание:
#   Повседневные графические приложения пользователя:
#   - Редактор кода VSCode (с поддержкой плагинов)
#   - Мессенджеры (Telegram Desktop, Discord, Vesktop, WhatsApp / ZapZap)
#   - Музыкальный плеер Spotify
#   - Среда разработки Google Antigravity IDE
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # ----------------------------------------------------------------------------
  # 1. РЕДАКТОР КОДА VISUAL STUDIO CODE
  # ----------------------------------------------------------------------------
  programs.vscode = {
    enable = true;

    # Разрешить установку и удаление плагинов через графический интерфейс (Marketplace)
    mutableExtensionsDir = true;

    # Декларативные расширения (управляются через Nix)
    profiles.default.extensions = with pkgs.vscode-extensions; [
      # Тема Catppuccin под общий стиль системы
      catppuccin.catppuccin-vsc
      catppuccin.catppuccin-vsc-icons

      # Поддержка языка Nix (подсветка, форматирование)
      jnoortheen.nix-ide
    ];
  };

  # ----------------------------------------------------------------------------
  # 2. МЕССЕНДЖЕРЫ, МУЗЫКА И ИНСТРУМЕНТЫ РАЗРАБОТКИ
  # ----------------------------------------------------------------------------
  home.packages = with pkgs; [
    # Мессенджеры
    telegram-desktop     # Официальный клиент Telegram
    discord              # Официальный клиент Discord
    vesktop              # Альтернативный клиент Discord (с поддержкой шеринга экрана со звуком под Wayland)
    zapzap               # WhatsApp Desktop клиент на Qt6 с поддержкой тёмной темы и уведомлений

    # Музыка
    spotify              # Официальный стриминговый клиент Spotify

    # Среда разработки
    antigravity-ide      # Google Antigravity IDE
  ];
}
