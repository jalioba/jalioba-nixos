# ==============================================================================
# МОДУЛЬ ПРОГРАММ: modules/programs/thunar.nix
# ==============================================================================
# Описание:
#   Графический файловый менеджер Thunar (Xfce).
#   Легковесный, быстрый, с поддержкой плагинов для работы с архивами,
#   миниатюр изображений (tumbler) и монтирования дисков/корзины (gvfs).
#
# Горячая клавиша в Niri:
#   Mod + Shift + F -> Открыть Thunar
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # Дополнительные утилиты для работы с архивами и предпросмотра
  home.packages = with pkgs; [
    # Графический менеджер архивов для распаковки/упаковки по правому клику
    file-roller

    # Превью и миниатюры файлов
    webp-pixbuf-loader # Поддержка превью WebP картинок
  ];

  # Настройки ассоциаций файлов по умолчанию для Thunar
  xdg.mimeApps = {
    enable = true;
    defaultApplications = {
      "inode/directory" = [ "thunar.desktop" ];
    };
  };
}
