# ==============================================================================
# МОДУЛЬ ПРОГРАММ: modules/programs/ghostty.nix
# ==============================================================================
# Описание:
#   Ghostty — сверхбыстрый эмулятор терминала нового поколения с аппаратным
#   ускорением на GPU, нативной поддержкой Wayland, отображением графики
#   (Kitty Graphics Protocol для предпросмотра файлов в Yazi) и вкладками.
#
# Как кастомизировать:
#   Конфигурация расположена в ~/.config/ghostty/config.
#   Вы можете легко изменить тему (например, tokyo-night, nord),
#   прозрачность (background-opacity) или размер шрифта.
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # Установка пакета Ghostty
  home.packages = with pkgs; [
    ghostty
  ];

  # Генерация файла конфигурации ~/.config/ghostty/config
  xdg.configFile."ghostty/config".text = ''
    # --------------------------------------------------------------------------
    # ШРИФТ И ТИПОГРАФИКА
    # --------------------------------------------------------------------------
    font-family = "JetBrainsMono Nerd Font"
    font-size = 12
    font-feature = +calt, +clig, +liga

    # --------------------------------------------------------------------------
    # ТЕМА И ЦВЕТОВАЯ ПАЛИТРА
    # --------------------------------------------------------------------------
    # Ghostty поставляется со встроенными темами (catppuccin-mocha, tokyo-night и др.)
    theme = "catppuccin-mocha"

    # Прозрачность фона (0.0 — полностью прозрачный, 1.0 — сплошной)
    background-opacity = 0.95

    # --------------------------------------------------------------------------
    # ОКНО И ОТСТУПЫ
    # --------------------------------------------------------------------------
    window-padding-x = 12
    window-padding-y = 10
    window-padding-balance = true
    window-decoration = false # Отключение заголовков окон для тайлинга

    # --------------------------------------------------------------------------
    # КУРСОР И МЫШЬ
    # --------------------------------------------------------------------------
    cursor-style = bar
    cursor-style-blink = true
    mouse-hide-while-typing = true

    # --------------------------------------------------------------------------
    # ИНТЕГРАЦИЯ С БУФЕРОМ ОБМЕНА WAYLAND
    # --------------------------------------------------------------------------
    clipboard-read = allow
    clipboard-write = allow
    clipboard-paste-protection = true

    # Запуск оболочки Fish по умолчанию
    command = "${pkgs.fish}/bin/fish"
  '';
}
