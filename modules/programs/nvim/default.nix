# ==============================================================================
# МОДУЛЬ ПРОГРАММ: modules/programs/nvim/default.nix
# ==============================================================================
# Описание:
#   Конфигурация Neovim + LazyVim по гибридной модели.
#   Nix управляет установкой Neovim, компиляторов (gcc, gnumake), парсеров
#   (tree-sitter), утилит поиска (ripgrep, fd) и языковых серверов (LSP).
#   Конфигурация LazyVim (Lua) монтируется в ~/.config/nvim, сохраняя
#   всю гибкость плагинной системы LazyVim без конфликтов с путями NixOS.
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # ----------------------------------------------------------------------------
  # 1. ПАКЕТ NEOVIM
  # ----------------------------------------------------------------------------
  programs.neovim = {
    enable = true;
    defaultEditor = true;
    viAlias = true;
    vimAlias = true;
    withNodeJs = true;
    withPython3 = true;
  };

  # ----------------------------------------------------------------------------
  # 2. ИНСТРУМЕНТЫ ДЛЯ РАБОТЫ ПЛАГИНОВ И LSP (УПРАВЛЯЮТСЯ ЧЕРЕЗ NIX)
  # ----------------------------------------------------------------------------
  home.packages = with pkgs; [
    # Компиляторы и утилиты сборки плагинов (Treesitter, Luarocks и т.д.)
    gcc
    gnumake
    unzip
    wget
    curl
    git
    tree-sitter

    # Быстрый поиск по кодовой базе (используется Snacks/Telescope в LazyVim)
    ripgrep
    fd

    # Языковые серверы (LSP) и форматтеры
    nil               # LSP для языка Nix
    nixpkgs-fmt       # Форматтер для файлов .nix
    lua-language-server # LSP для языка Lua (конфиги Neovim)
    stylua            # Форматтер для файлов Lua
  ];

  # ----------------------------------------------------------------------------
  # 3. ПОДКЛЮЧЕНИЕ СТАРТОВОГО КОНФИГА LAZYVIM В ~/.config/nvim
  # ----------------------------------------------------------------------------
  xdg.configFile."nvim".source = ./config;
  xdg.configFile."nvim".recursive = true;
}
